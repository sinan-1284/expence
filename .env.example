# Copy to .env (chmod 600). Used by server.py (local) and deploy/deploy.sh (AWS).
DASHBOARD_PASSWORD=change-me
# long random string; changing it logs everyone out:  python3 -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=
# Discord channel → Edit channel → Integrations → Webhooks → New webhook → Copy webhook URL
DISCORD_WEBHOOK_URL=
# the dashboard's address, used for links in Discord messages and allowed to call the API
PUBLIC_URL=https://expence.nexbotlabs.in
